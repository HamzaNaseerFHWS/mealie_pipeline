# Copy to deploy/.env (git-ignored) and fill in. Secrets live only here, never in the image.

# --- Telegram inbox bot -------------------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your chat id(s), comma-separated (you and your partner). Leave empty at first: message the bot and
# it replies with your chat id.
TELEGRAM_CHAT_ID=
# A long random string shared by the bot and the pipeline, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
INBOX_API_TOKEN=

# --- Mealie -------------------------------------------------------------------------------------
# Leave empty on the Mealie PC (the default is http://host.docker.internal:9000).
# On the laptop, use the Tailscale address, e.g. http://mealie.taildce5a6.ts.net:9000 or http://100.x.y.z:9000.
MEALIE_URL=
# Mealie -> Profile -> API Tokens.
MEALIE_TOKEN=

# --- Claude (Claude Pro subscription; never an API key) ------------------------------------------
# Option A: run `claude setup-token` once (on the laptop or in the container) and paste the token here.
# Option B: leave it empty and log in once inside the container (see deploy/README.md).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional -------------------------------------------------------------------------------------
# Build without Google Chrome (smaller image; link-in-bio pages are then reported, not read).
# WITH_CHROME=false
# Seconds between two looks at the inbox (default 60).
# INBOX__POLL_SECONDS=60
# Simultaneous `claude -p` calls (default 2).
# LLM__MAX_PARALLEL=2
