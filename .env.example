# Copy to .env (git-ignored). Secrets live only here.

# Base URL of the Mealie instance, reached over Tailscale.
MEALIE_URL=http://mealie.taildce5a6.ts.net:9000
# API token: Mealie -> Profile -> API Tokens.
MEALIE_TOKEN=
# Emergency fallback only; unused unless `mp run --allow-openai` is passed.
OPENAI_API_KEY=
# Hard spend cap for the OpenAI fallback, in USD.
OPENAI_MAX_USD=5
